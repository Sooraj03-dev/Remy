# ============================================================
# Mobile environment variables — Campus Marketplace
# EXPO_PUBLIC_* variables are bundled into the app.
# NEVER put secret keys here — only publishable/public values.
# ============================================================

# Base URL of the Express API
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Clerk publishable key (safe to include in mobile)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

