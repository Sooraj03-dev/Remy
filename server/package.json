{
  "name": "campus-marketplace-server",
  "version": "1.0.0",
  "description": "Campus Marketplace REST API — Express + TypeScript + Drizzle + Neon",
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "test": "NODE_ENV=test tsx --test src/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@clerk/express": "^1.3.0",
    "@neon/realtime": "^0.2.1",
    "@neondatabase/serverless": "^0.9.4",
    "@types/multer": "^2.3.0",
    "cloudinary": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "expo": "^58.0.26",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/react": "~19.3.0",
    "drizzle-kit": "^0.21.4",
    "tsx": "^4.14.1",
    "typescript": "^5.4.5"
  }
}
